# Copy to .env and edit. Every value below is optional — the defaults shown are what
# the application uses when the variable is unset.

# --------------------------------------------------------------------------- #
# Storage
# --------------------------------------------------------------------------- #
# Scan log, saved results and crawl checkpoints. Relative paths resolve against the
# working directory, so run_server.py pins this to the project root. In Docker it is
# set to /data and backed by a volume.
DATA_DIR=data

# --------------------------------------------------------------------------- #
# Authentication
# --------------------------------------------------------------------------- #
# Off by default so a local checkout runs with no configuration. Turn it ON for any
# deployment reachable by anything but you: every endpoint serves harvested contact
# data, so leaving it off is a data leak rather than merely an open API.
#
# HTTP Basic, applied as middleware over every route including /docs and the UI.
# Enabling it without both a user and a password is a startup error, not a warning.
# /api/health stays open so an orchestrator can probe liveness.
MAILCRAWL_AUTH_ENABLED=false
MAILCRAWL_USER=
MAILCRAWL_PASSWORD=
MAILCRAWL_AUTH_REALM=MailCrawl

# --------------------------------------------------------------------------- #
# Server
# --------------------------------------------------------------------------- #
HOST=127.0.0.1
PORT=8000

# Each scan drives its own Chromium instance, so the browser is what caps this.
MAX_CONCURRENT_SCANS=2

# How long a finished scan stays in memory. Results are on disk either way and the
# results endpoint falls back to disk, so eviction loses nothing.
JOB_TTL_SECONDS=3600
CLEANUP_INTERVAL_SECONDS=60

# --------------------------------------------------------------------------- #
# Live stream (server-sent events)
# --------------------------------------------------------------------------- #
# The crawler reports once per URL; progress events are coalesced to this rate so a
# large scan does not push one event per page.
PROGRESS_MAX_HZ=5.0
# Ring buffer of events replayed to a reconnecting client. A client further behind
# than this gets a full snapshot instead.
EVENT_BUFFER_SIZE=2000
LIVE_EMAIL_CAP=5000
MAX_EMAILS_PER_EVENT=200
KEEPALIVE_SECONDS=15.0
SSE_RETRY_MS=2000

# --------------------------------------------------------------------------- #
# Results paging
# --------------------------------------------------------------------------- #
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=2000

# --------------------------------------------------------------------------- #
# Batch jobs (file validation and SignalHire crawls)
# --------------------------------------------------------------------------- #
# These do not drive a browser, so they are cheaper than a scan — but a validation
# holds every result in memory and takes a thread-pool slot per SMTP probe.
MAX_CONCURRENT_VALIDATIONS=3
MAX_CONCURRENT_SIGNALHIRE=3

# How long a finished batch job stays in memory. Results are written to disk as the
# job ends and both history endpoints fall back to disk, so eviction loses nothing.
BATCH_JOB_TTL_SECONDS=3600

# Ceiling on an uploaded validation file. The body is read in chunks and rejected
# the moment it crosses this, so an oversized upload never fully lands in memory.
MAX_UPLOAD_MB=50

# Ceiling on a client-supplied export payload, which is built into a workbook
# in memory.
MAX_EXPORT_ROWS=100000

# --------------------------------------------------------------------------- #
# Crawl limits
# --------------------------------------------------------------------------- #
MAX_RESPONSE_SIZE_MB=25
MAX_PDF_SIZE_MB=150

# Subdomain discovery. Coverage is the default: 0 means unlimited.
SUBDOMAIN_DISCOVERY=true
CRT_SH_TIMEOUT_SECONDS=120
MAX_SUBDOMAINS=0
MAX_EXTERNAL_SOURCES=0

# Set true to skip dev/mail/internal hosts, trading coverage for a faster scan.
SKIP_NON_PUBLIC_SUBDOMAINS=false

# Grace period for in-flight scans to checkpoint themselves on shutdown.
SHUTDOWN_JOIN_SECONDS=30.0
